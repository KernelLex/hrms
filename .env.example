# Copy to .env.local and fill in. Never commit .env.local.

# --- Turso (libSQL) ---
# Create a database at https://turso.tech, then read these from its dashboard.
# For local development you may instead point at a file: TURSO_DATABASE_URL="file:./local.db"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cloudflare R2 (optional) ---
# R2 is S3-compatible. Create a bucket and an API token with object read/write.
# Leave all four empty to store uploaded documents in the database instead;
# set all four and new uploads go to R2 (existing ones keep being read from
# wherever they were stored).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Demo sign-in ---
# While this is a prototype, the sign-in page signs straight into a seeded demo
# account on one click. Set to "off" once real accounts exist. The sign-in page
# is prerendered, so a change takes effect on the next deploy.
DEMO_SIGN_IN=
