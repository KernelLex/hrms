# Normalise line endings. The repo stores LF; Windows checkouts may use CRLF
# locally, but Vercel builds on Linux and shell scripts must not carry CRLF.
* text=auto eol=lf

# Binary assets, never normalised
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.db binary
